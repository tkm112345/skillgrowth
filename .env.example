# OpenAI-compatible endpoint. Works with OpenAI, Anthropic (via compatible proxy),
# or a local Ollama server exposing /v1 (e.g. http://localhost:11434/v1).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Model used for image extraction (certifications). Must support vision.
# For Ollama, try a vision-capable model such as llava.
LLM_VISION_MODEL=gpt-4o-mini
